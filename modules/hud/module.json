{
  "id": "hud",
  "title": "QuantHUD",
  "description": "Always-on-top overlay, screen capture and quick actions",
  "status": "migrated",
  "phase": 6,
  "source": "C:/Projects/QuantHUD",
  "routes": {
    "root": "/hud",
    "home": "/hud"
  },
  "plugin": "hud",
  "ownWindow": {
    "command": "plugin:hud|open_hud"
  },
  "publishes": [
    "hud.capture.taken"
  ],
  "subscribes": [
    "algo.trade.executed"
  ],
  "entities": [
    "capture"
  ],
  "sidecars": [
    {
      "id": "quantvoice",
      "kind": "python",
      "shared": false,
      "lazy": true
    }
  ],
  "capabilities": [],
  "migrateFrom": "<config_dir>/quanthub",
  "remote": {
    "commands": {
      "capture_screen": "client:external",
      "get_cursor_position": "client:read",
      "get_available_monitors": "client:read",
      "load_config": "client:read",
      "save_config": "client:write",
      "tuck_window": "client:read",
      "show_window": "client:read",
      "is_window_tucked": "client:read",
      "setup_window_size": "client:read",
      "set_window_position": "client:write",
      "open_region_selector": "client:write",
      "set_selected_region": "client:write",
      "get_selected_region": "client:read",
      "pick_screen_color": "client:read",
      "pick_folder": "client:read",
      "pick_file": "client:read",
      "launch_app": "client:external",
      "get_app_icon": "client:read",
      "get_default_screenshots_folder": "client:read",
      "list_os_screenshots": "client:read",
      "read_screenshot_file": "client:read",
      "read_screenshot_thumbnail": "client:read",
      "open_screenshots_folder": "client:write",
      "copy_screenshot_to_clipboard": "client:external",
      "open_color_picker_overlay": "client:write",
      "set_picked_color": "client:write",
      "get_picked_color": "client:read",
      "open_screenshot_preview": "client:external",
      "get_screenshot_preview_path": "client:read",
      "close_screenshot_preview": "client:external",
      "create_dual_window": "client:write",
      "close_dual_window": "client:write",
      "show_notification_popup": "client:read",
      "speech_status": "client:read",
      "speech_setup": "client:read",
      "speech_start": "client:write",
      "speech_stop": "client:write",
      "speech_cancel": "client:write",
      "speech_devices": "client:read",
      "speech_apply_settings": "client:write",
      "speech_engine_start": "client:write",
      "speech_engine_stop": "client:write",
      "speech_engine_logs": "client:read",
      "analyze_chart": "client:compute",
      "save_temp_image": "client:write",
      "open_hud": "client:write",
      "close_hud": "client:write"
    }
  }
}
