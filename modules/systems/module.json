{
  "id": "systems",
  "title": "QuantSystems",
  "description": "Multi-system quantitative evaluation suite",
  "status": "migrated",
  "mergedInto": "algo",
  "phase": 1,
  "app": "quantview",
  "appOrder": 3,
  "source": "C:/Projects/QuantSystems",
  "routes": {
    "root": "/systems",
    "home": "/systems"
  },
  "plugin": "systems",
  "publishes": [
    "systems.engine.status",
    "systems.backtest.completed",
    "systems.signal.generated"
  ],
  "subscribes": [
    "market.symbol.selected",
    "core.theme.changed"
  ],
  "entities": [
    "system",
    "backtest",
    "universe_snapshot"
  ],
  "sidecars": [
    {
      "id": "python-engine",
      "kind": "python",
      "shared": true,
      "lazy": true
    }
  ],
  "capabilities": [
    {
      "name": "list_systems",
      "command": "plugin:systems|list_systems",
      "description": "List the evaluation systems and their readiness.",
      "sideEffects": "read"
    },
    {
      "name": "run_manual_backtest",
      "command": "plugin:systems|run_backtest",
      "description": "Run a rotation backtest for a system over its configured range.",
      "sideEffects": "compute"
    },
    {
      "name": "live_eval",
      "command": "plugin:systems|live_eval",
      "description": "Score today's universe for a system without trading.",
      "sideEffects": "compute"
    }
  ],
  "migrateFrom": "~/.quantsystems",
  "remote": {
    "events": ["engine:status","eval:progress","backtest:complete","cache:updated"],
    "commands": {
      "get_app_settings": "server:read",
      "update_app_settings": "server:write",
      "list_systems": "server:read",
      "create_system": "server:write",
      "delete_system": "server:write",
      "get_system_config": "server:read",
      "save_system_config": "server:write",
      "start_engine": "server:write",
      "stop_engine": "server:write",
      "engine_status": "server:read",
      "live_eval": "server:compute",
      "pair_markets": "server:read",
      "run_backtest": "server:compute",
      "browse_universe": "server:read",
      "cache_stats": "server:read",
      "clear_cache": "server:write",
      "ranking_archive": "server:write",
      "screenshot_to_clipboard": "client:write"
    }
  }
}
